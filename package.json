{
  "name": "rebirth-338",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --base /rebirth-338/",
    "test": "vitest run",
    "proto": "vite --config vite.proto.config.ts",
    "proto:build": "tsc -p tsconfig.proto.json && vite build --config vite.proto.config.ts",
    "desktop:build": "vite build --config apps/web/vite.config.ts --mode desktop && vite build --config apps/desktop/vite.config.ts && vite build --config apps/desktop/vite.config.ts --mode preload",
    "desktop": "npm run desktop:build && electron apps/desktop",
    "desktop:dev": "vite build --config apps/desktop/vite.config.ts && vite build --config apps/desktop/vite.config.ts --mode preload && electron apps/desktop --dev"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "44.7.2",
    "jsdom": "latest",
    "playwright": "^1.63.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
